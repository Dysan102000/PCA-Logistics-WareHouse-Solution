@page "/grnscanning"
@using PCA_Logistics_WareHouse_Web_App.Data
@using System.IO
@using System.Text.Json
@inherits PCA_Logistics_WareHouse_Web_App.Components.Pages.GrnScanning

<PageTitle>GRN Scanning | PCA Logistics</PageTitle>

@* We include the CSS styles here for easy reference and component-level scope. *@
<style>
    .btn-pca-primary {
        background-color: #183B7D; /* PCA Dark Blue */
        border-color: #183B7D;
        color: white;
    }

        .btn-pca-primary:hover {
            background-color: #122c5e;
            border-color: #122c5e;
        }

    .text-pca-primary {
        color: #183B7D;
    }

    .bg-pca-accent {
        background-color: #AEC435 !important; /* PCA Olive Green */
    }
</style>

<div class="grn-processing-container container">
    <h2 class="mb-4">
        📦 GRN Scanning &nbsp;
        @* FIX: Removed duplicate button and added Save button (assuming SaveGrnData exists in code-behind) *@
        <button class="btn btn-pca-primary btn-sm" @onclick="DevHydrateFields">📦 Auto Fill</button>
        <button class="btn btn-pca-primary btn-sm" @onclick="SaveGrnData">💾 Save Data</button>
        <button class="btn btn-pca-primary btn-sm" @onclick="ViewGrnPdf">📄 View GRN</button>
    </h2>

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-pca-accent text-white">
            <h4 class="m-0">1. Add GRN Receipt Number</h4>
        </div>
        <div class="card-body">
            <div class="input-group input-group-lg">
                <input id="inReceiptNo" type="text" class="form-control"
                       placeholder="Enter Receipt No."
                       @bind="@grnModel.ReceiptNo"
                       @onkeyup="HandleGrnIdInput"
                       @ref="inputElement"
                       aria-label="GRN Receipt Number Input" />
            </div>
        </div>
    </div>
    
    @* --- NEW: DOCUMENT UPLOAD SECTION --- *@
    <h4 class="mt-5 mb-3 text-pca-primary">2. Upload Documents (PDF/Image)</h4>
    <div class="card mb-4 shadow-sm">
        <div class="card-header">
            <h5 class="m-0">Delivery Note & Driver's Licence 📑</h5>
        </div>
        <div class="card-body">
            <p class="text-muted">Please upload scanned documents for the GRN: @grnModel.ReceiptNo</p>

            @* Blazor InputFile component to handle uploads *@
            <InputFile OnChange="@HandleFileSelection" multiple />

            <div class="mt-3">
                <h6>Uploaded Files (@(grnModel.ScannedDocumentReferences?.Count ?? 0)):</h6>
                @if (grnModel.ScannedDocumentReferences != null && grnModel.ScannedDocumentReferences.Any())
                {
                    <ul>
                        @foreach (var fileName in grnModel.ScannedDocumentReferences)
                        {
                            <li>✅ @fileName</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No documents uploaded yet.</p>
                }
            </div>
        </div>
    </div>
    @* --- END NEW SECTION --- *@

    <h4 class="mt-5 mb-3 text-pca-primary">3. GRN Details</h4>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-primary h-100">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Received From</label>
                        <input type="text" class="form-control" @bind="@grnModel.ReceivedFrom" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Received For</label>
                        <input type="text" class="form-control" @bind="@grnModel.ReceivedFor" />
                    </div>
                    <hr />
                    <div class="mb-3">
                        <label for="totalBoxes" class="form-label fw-bold">
                            T. Boxes
                        </label>
                        <input id="totalBoxes" type="number" class="form-control" @bind="@grnModel.BoxCount" />
                    </div>
                    <div class="mb-0">
                        <label for="totalWeight" class="form-label fw-bold">
                            T. Weight (kg)
                        </label>
                        <input id="totalWeight" type="number" class="form-control" @bind="@grnModel.TotalWeightKg" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card border-primary h-100">
                <div class="card-header">Driver & Shipment Info</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="">Driver</label>
                        <input id="inDriverName" type="text" class="form-control" placeholder="Driver Name" @bind="@grnModel.DriverName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Identity No.</label>
                        <input type="text" class="form-control" placeholder="ID Number" @bind="@grnModel.DriverIdNo" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Truck Reg.</label>
                        <input type="text" class="form-control" placeholder="Truck Reg. No." @bind="@grnModel.TruckRegNo" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Time Arrived.</label>
                        <input type="datetime-local" class="form-control" placeholder="Arrival Time" @bind="@grnModel.ArrivalTimestamp" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mt-5 mb-3 text-pca-primary">4. Product and Condition Checks</h4>
    <div class="table-responsive mb-4">
        <table class="table table-bordered table-striped">
            <thead class="bg-pca-accent text-white">
                <tr>
                    <th>Product</th>
                    <th>Del No</th>
                    <th>Qty DN</th>
                    <th>Qty Rec.</th>
                    <th>Temp (°C)</th>
                    <th style="width: 50px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in grnModel.ProductLines)
                {
                    <tr>
                        <td><input type="text" class="form-control" @bind="@line.Product" placeholder="Product Name" /></td>
                        <td><input type="text" class="form-control" @bind="@line.DeliveryNoteNo" placeholder="DN #" /></td>
                        <td><input type="number" class="form-control" @bind="@line.QuantityOnDeliveryNote" /></td>
                        <td><input type="number" class="form-control" @bind="@line.QuantityReceived" /></td>
                        <td><input type="number" class="form-control" @bind="@line.Temperature" /></td>
                        <td class="text-center">
                            <button class="btn btn-danger btn-sm" @onclick="@(() => RemoveProductLine(line))" title="Remove line">X</button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="6" class="text-end">
                        <button type="button" class="btn btn-pca-primary" @onclick="AddProductLine">
                            + Add Product Line
                        </button>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <h4 class="mt-5 mb-3 text-pca-primary">5. AVSEC Security Checks</h4>
    <div class="row mb-5">
        <div class="col-md-6">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="grnModel.IsDriversIdentityChecked" id="check1">
                <label class="form-check-label" for="check1">
                    Drivers' identity checked upon receipt of cargo.
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="grnModel.IsVehicleChecked" id="check2">
                <label class="form-check-label" for="check2">
                    Vehicle checked for any tampering or unlawful interference.
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="grnModel.AreDeliveryDocumentsChecked" id="check3">
                <label class="form-check-label" for="check3">
                    Delivery documents checked against contents of cargo.
                </label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="grnModel.IsKnownConsignorChecked" id="check4">
                <label class="form-check-label" for="check4">
                    Checked for Known Consignor / Regulated Agent status.
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="grnModel.IsCargoStoredSecurely" id="check5">
                <label class="form-check-label" for="check5">
                    Cargo stored in secured area after screening.
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="grnModel.IsDangerousGoods" id="check6">
                <label class="form-check-label" for="check6">
                    Dangerous Goods (Confirm YES/NO).
                </label>
            </div>
        </div>
    </div>

    <div class="text-center">
        <button class="btn btn-success btn-lg" @onclick="FinalizeGrnProcessing">
            ✅ Finalize GRN & Accept Goods
        </button>
        <p class="text-muted mt-2">
            All checks and quantities must be confirmed before finalizing.
        </p>
    </div>

</div>