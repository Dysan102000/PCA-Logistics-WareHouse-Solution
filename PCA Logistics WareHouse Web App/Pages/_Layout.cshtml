@using Microsoft.AspNetCore.Components.Web
@using PCA_Logistics_WareHouse_Web_App.Shared
@namespace PCA_Logistics_WareHouse_Web_App.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="PCA Logistics WareHouse Web App.styles.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    @RenderBody()

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <AppNotification />

    <script src="_framework/blazor.server.js"></script>
    <script>
        // Simple global function to apply focus to a DOM element reference
        function focusElement(element) {
            if (element instanceof HTMLElement) {
                element.focus();
            }
        }

        // Add this new function to your JavaScript file or index.html/App.razor
        function openPdfInNewTab(base64Data) {
            var dataUri = "data:application/pdf;base64," + base64Data;
            // window.open will load the Data URI in a new tab, prompting the PDF viewer.
            window.open(dataUri, '_blank');
        }

                // Add this function to your client-side JavaScript
        function openFileInNewTab(mimeType, base64Data) {
            // Construct the Data URI: data:[MIME_TYPE];base64,[BASE64_DATA]
            var dataUri = "data:" + mimeType + ";base64," + base64Data;

            // Open the Data URI in a new tab
            window.open(dataUri, '_blank');
        }
    </script>

    <script>
        // This is the function called from the GrnScanning.razor.cs code-behind
        window.saveAsFile = function (fileName, base64String) {
            // 1. Convert Base64 string to a blob
            var link = document.createElement('a');
            link.href = "data:application/pdf;base64," + base64String;
            link.target = '_blank'; // Opens in a new tab

            // 2. Set the download attribute (optional, for download prompt)
            link.download = fileName;

            // 3. Trigger the click event to open the file
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

    </script>

</body>
</html>
